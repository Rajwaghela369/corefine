# Copy to backend/.env. Only the backend reads this file; the browser and the sandbox never see it.
# local = no cloud accounts needed (disk, SQLite, local Qdrant, subprocess runner).
# cloud = every key below is required; startup fails naming any that is missing.
COREFINE_MODE=local

ANTHROPIC_API_KEY=
MODEL_MAIN=claude-sonnet-5-5        # Planner, Coder, Analyst (spec: Sonnet-class)
MODEL_FAST=claude-haiku-5-5         # chat co-pilot, run summaries (spec: Haiku-class)
LLM_SERVER_FALLBACKS=true           # retry declined requests on Anthropic's recommended fallback model

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

DATABASE_URL=                       # Neon pooled connection string (postgres://...)

QDRANT_URL=
QDRANT_API_KEY=
EMBED_PROVIDER=fastembed            # or qdrant_cloud if the cluster offers cloud inference
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

DAYTONA_API_KEY=
DAYTONA_SNAPSHOT=corefine-sci       # built by: uv run python scripts/setup.py --snapshot

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# All-electron DFT codes (optional; a code whose path is unset is skipped)
EXCITING_ROOT=                      # exciting source tree (species/, xml/schema/)
QUESTAAL_BIN=                       # folder containing blm, lmfa, lmchk, lmf
QUESTAAL_LIB_ROOT=                  # Spack opt/spack tree if Questaal was built with Spack
MP_API_KEY=                         # optional; Materials Project is also read via OPTIMADE without a key
QE_PSEUDO_DIR=                      # Quantum ESPRESSO .UPF pseudopotentials (e.g. an SSSP library folder)
VASP_PP_PATH=                       # licensed VASP POTCARs: <path>/potpaw_PBE/<El>/POTCAR
COMPUTE_CONFIG=                     # optional; default backend/compute.yaml (see compute.example.yaml)
